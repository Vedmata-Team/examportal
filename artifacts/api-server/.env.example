# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://USERNAME:PASSWORD@localhost:5432/examportal

# ── Session ───────────────────────────────────────────────────────────────────
# Must match SESSION_SECRET in the Next.js frontend .env
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL of the Next.js frontend — only this origin is allowed
FRONTEND_URL=http://localhost:3000

# ── Clerk (optional) ──────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
